<Window x:Class="OverlayBrowser.Form.TranslationHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Browser - 翻訳のHelp"
        Width="700"
        Height="580"
        MinWidth="580"
        MinHeight="440"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="翻訳のHelp / Translation Help" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap">
                    <Run Text="英語などのページ上で右クリックし、［ページを翻訳］を選ぶと、今開いているタブをGoogle翻訳のページ翻訳表示へ切り替えます。翻訳先はWindowsの表示言語を自動で使用します。ログインが必要なサイト、Cloudflareなどのアクセス保護があるサイトは、Google翻訳側の制約で表示できない場合があります。その場合は［Geminiでページを翻訳］を使ってください。" />
                    <LineBreak /><LineBreak />
                    <Run Text="初回だけGemini APIキーが必要です。［設定］→［Gemini APIキー］を開き、Google AI Studioで作成したキーを保存してください。キーはJSON設定ファイルではなく、Windows資格情報マネージャーに保存されます。" />
                    <LineBreak /><LineBreak />
                    <Run Text="1. 下のボタンからGoogle AI Studioを開きます。" />
                    <LineBreak />
                    <Run Text="2. ［Gemini API］→［インポート］→［キーを作成］の順で新しいキーを作成します。" />
                    <LineBreak />
                    <Run Text="3. 作成したキーをコピーし、このアプリの［設定］→［Gemini APIキー］で保存します。" />
                    <LineBreak />
                    <Run Text="4. ［設定］→［翻訳のカスタマイズ］で、文体、説明の詳しさ、ゲーム用語の扱いなどを指定できます。この設定は、右クリックの［Geminiでページを翻訳］を使う時にGeminiへ渡されます。" />
                    <LineBreak />
                    <Run Text="5. ChromeのようにGoogle翻訳を表示したい場合は［ページを翻訳］、元のレイアウトを保ったまま文章だけをGeminiで置き換えたい場合は［Geminiでページを翻訳］を選びます。Gemini翻訳後に元へ戻したい時はページを再読み込みします。" />
                    <LineBreak /><LineBreak />
                    <Run Text="翻訳のカスタマイズにAPIキーやパスワードなどの秘密情報は入力しないでください。Gemini翻訳では、入力した指示とページ内の表示文章がGemini APIへ送信されます。画像・CSS・スクリプトは送信しません。APIキーは他人に共有せず、Googleが漏えいと判定したキーは再利用しないでください。" />
                </TextBlock>
                <Button Width="260" Margin="0,22,0,0" HorizontalAlignment="Left" Content="Google AI StudioでAPIキーを作成" Click="OpenGoogleAiStudioButton_Click" />
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Width="110" Margin="0,20,0,0" HorizontalAlignment="Right" Content="閉じる / Close" Background="#243650" BorderBrush="#55738F" Click="CloseButton_Click" />
    </Grid>
</Window>
