<Window x:Class="OverlayBrowser.Form.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:OverlayBrowser.Model"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ブックマーク一覧"
        Width="700"
        Height="620"
        MinWidth="480"
        MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}"
        FontFamily="Yu Gothic UI">
    <shell:WindowChrome.WindowChrome>
        <!-- メイン画面と同じ暗色タイトルバーを使う。 -->
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- フォルダは子要素を持つツリー項目として表示する。 -->
        <HierarchicalDataTemplate DataType="{x:Type model:BookmarkItem}"
                                  ItemsSource="{Binding Children}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemIcon"
                           Text="↗"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           Foreground="{StaticResource MainTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Url}"
                           VerticalAlignment="Center" />
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="ItemIcon" Property="Text" Value="◆" />
                    <Setter TargetName="ItemIcon" Property="Foreground" Value="{StaticResource AccentSecondaryBrush}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Foreground" Value="#F4FAFF" />
            <Setter Property="Background" Value="#346E96" />
            <Setter Property="BorderBrush" Value="#77DDF4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E96C4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334761" />
                    <Setter Property="Foreground" Value="#8496AF" />
                    <Setter Property="BorderBrush" Value="#4C6684" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D4968" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0B1324"
                    BorderBrush="#233557"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="WindowTitleTextBlock"
                               Margin="14,0"
                               Text="ブックマーク一覧"
                               FontWeight="SemiBold"
                               Foreground="#EDF6FF"
                               VerticalAlignment="Center" />
                    <Button Width="46"
                            Height="42"
                            HorizontalAlignment="Right"
                            Content="×"
                            FontSize="20"
                            Foreground="#D9EAFA"
                            Background="Transparent"
                            BorderThickness="0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="18,16,18,10"
                    Padding="12,9"
                    Background="#1C3551"
                    BorderBrush="#3B5A77"
                    BorderThickness="1"
                    CornerRadius="5">
                <TextBlock x:Name="GuideTextBlock"
                           Text="フォルダの ▶ を押して開き、サイト名を選択してください。ダブルクリックでも開けます。"
                           Foreground="{StaticResource SubTextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="2"
                    Margin="18,0"
                    Padding="6"
                    Background="#162641"
                    BorderBrush="#3B5A77"
                    BorderThickness="1"
                    CornerRadius="5">
                <TreeView x:Name="BookmarkTreeView"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemsSource="{Binding}"
                          AllowDrop="True"
                          SelectedItemChanged="BookmarkTreeView_SelectedItemChanged"
                          MouseDoubleClick="BookmarkTreeView_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="BookmarkTreeView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="BookmarkTreeView_PreviewMouseMove"
                          DragOver="BookmarkTreeView_DragOver"
                          Drop="BookmarkTreeView_Drop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                            <Setter Property="Padding" Value="3" />
                            <Setter Property="IsExpanded" Value="False" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <Grid Grid.Row="3" Margin="18,14,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionTextBlock"
                           Foreground="{StaticResource SubTextBrush}"
                           Text="サイトを選択してください"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="RootDestinationButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="トップへ追加"
                        Visibility="Collapsed"
                        Click="RootDestinationButton_Click" />
                <Button Grid.Column="2"
                        x:Name="OpenButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="開く"
                        IsEnabled="False"
                        Click="OpenButton_Click" />
                <Button Grid.Column="3"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="閉じる"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
