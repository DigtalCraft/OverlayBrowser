<Window x:Class="OverlayBrowser.Form.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        mc:Ignorable="d"
        Title="Overlay Browser"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        Foreground="{StaticResource MainTextBrush}"
        FontFamily="Yu Gothic UI"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <!-- 白い標準タイトルバーを使わず、アプリ側の濃色タイトルバーで統一する。 -->
        <!-- 透明ウィンドウでも端をつかみやすいよう、リサイズ判定を広げる。 -->
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="12" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 青黒のガラス面にシアンと紫を重ねるテーマ。 -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#162641" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MenuItemSurface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="CheckMark"
                                          Width="12"
                                          Height="10"
                                          Margin="3,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Data="M1,5 L4,8 L11,1"
                                          Stroke="#78E6FF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                    <ContentPresenter x:Name="HeaderPresenter"
                                                      Margin="24,0,0,0"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path x:Name="SubmenuArrow"
                                          Grid.Column="1"
                                          Width="5"
                                          Height="9"
                                          Margin="18,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="#88A7C4"
                                          Data="M0,0 L5,4.5 L0,9 Z"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Border x:Name="TopLevelInsetDivider"
                                    Width="3"
                                    Margin="0,7,-1,7"
                                    HorizontalAlignment="Right"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <!-- 左を暗く、右をわずかに明るくして浅い溝に見せる。 -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#081426" />
                                        <GradientStop Offset="0.45" Color="#253B55" />
                                        <GradientStop Offset="1" Color="#89A8C2" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PlacementTarget="{Binding ElementName=MenuItemSurface}"
                                   PopupAnimation="Fade">
                                <Border Margin="3"
                                        Padding="5"
                                        MinWidth="210"
                                        Background="#12223B"
                                        BorderBrush="#41627F"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.38" ShadowDepth="3" Color="#02060D" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                                <Setter TargetName="TopLevelInsetDivider" Property="Visibility" Value="Visible" />
                                <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="14,9" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="TopLevelInsetDivider" Property="Visibility" Value="Visible" />
                                <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="14,9" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemSurface" Property="Background" Value="#274565" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="MenuItemSurface" Property="Background" Value="#294C70" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#71839B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#35516C" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="#15233A" />
            <Setter Property="BorderBrush" Value="#55738F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#346E96" />
            <Setter Property="Foreground" Value="#F4FAFF" />
            <Setter Property="BorderBrush" Value="#77DDF4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E96C4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334761" />
                    <Setter Property="Foreground" Value="#8496AF" />
                    <Setter Property="BorderBrush" Value="#4C6684" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrowserActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#1B2D4A" />
            <Setter Property="BorderBrush" Value="#3F769E" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263E62" />
                    <Setter Property="BorderBrush" Value="#B8ACFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9EAFA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263A59" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5361B3" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrowserTabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9C9DE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F769E" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#162641" />
            <Setter Property="Foreground" Value="#B9C9DE" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderBrush" Value="#334F70" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#1E3558" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#5B88AA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#29486F" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#6ED8F5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#71839B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#243B61" />
                    <Setter Property="Foreground" Value="#F4FAFF" />
                    <Setter Property="BorderBrush" Value="#B8ACFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#2D4968" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- アプリ名とウィンドウ操作を一体化したカスタムタイトルバー。 -->
            <Border x:Name="TitleBarSurface" Grid.Row="0" Background="#0B1324" BorderBrush="#233557" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="#162641" BorderBrush="#65D8F4" BorderThickness="1" CornerRadius="5" Padding="2">
                            <Image Source="/Assets/OverlayBrowser.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="9,0,0,0" Text="Overlay Browser" FontWeight="SemiBold" Foreground="#EDF6FF" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" FontSize="18" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="□" FontSize="15" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="×" FontSize="20" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ブラウザ操作とオーバーレイ表示をまとめたメニューバー。 -->
            <Menu x:Name="MenuBarSurface" Grid.Row="1" BorderBrush="#334F70" BorderThickness="0,0,0,1">
                <MenuItem Header="ブラウザ">
                    <MenuItem Header="新しいタブ" Click="NewTabMenuItem_Click" />
                    <MenuItem Header="ホームを開く" Click="OpenHomeMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="再読み込み" Click="ReloadMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="ブックマーク" x:Name="BookmarkMenuItem" SubmenuOpened="BookmarkMenuItem_SubmenuOpened">
                    <MenuItem Header="ブックマークがありません" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="ブックマーク整理">
                    <MenuItem Header="Chromeからインポート" Click="ImportChromeMenuItem_Click" />
                    <MenuItem Header="Edgeからインポート" Click="ImportEdgeMenuItem_Click" />
                    <MenuItem Header="HTMLファイルからインポート" Click="ImportHtmlMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Chrome / Edge 用HTMLへエクスポート" Click="ExportHtmlMenuItem_Click" />
                    <MenuItem Header="保存済みブックマークをすべて削除" Click="ClearBookmarksMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="設定">
                    <MenuItem Header="常に前面に表示" x:Name="TopmostMenuItem" IsCheckable="True" Click="TopmostMenuItem_Click" />
                    <MenuItem Header="Windowsの起動時にタスクトレイへ常駐" x:Name="StartWithWindowsMenuItem" IsCheckable="True" Click="StartWithWindowsMenuItem_Click" />
                    <MenuItem Header="ブックマークバーを固定表示" x:Name="BookmarkBarMenuItem" IsCheckable="True" Click="BookmarkBarMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Gemini APIキー" Click="GeminiApiKeyMenuItem_Click" />
                    <MenuItem Header="翻訳のカスタマイズ" Click="TranslationPersonalizationMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="ヘルプ">
                    <MenuItem Header="使い方 / How to use" Click="HelpMenuItem_Click" />
                    <MenuItem Header="翻訳のHelp / Translation Help" Click="TranslationHelpMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="終了" Click="ExitMenuItem_Click" />
            </Menu>

            <!-- 保存済みの階層を保ったまま、よく使うブックマークを横一列へ固定表示する。 -->
            <Border x:Name="BookmarkBarSurface"
                    Grid.Row="2"
                    Padding="10,2"
                    Background="#122039"
                    BorderBrush="#2F506D"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Margin="4,0,8,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{StaticResource AccentBrush}"
                               Text="&#xE734;"
                               ToolTip="固定ブックマーク" />
                    <Menu x:Name="BookmarkBarMenu"
                          Padding="0"
                          Background="Transparent" />
                </DockPanel>
            </Border>

            <!-- シアン寄りの縁取りで、ツールバー上の操作を見分けやすくする。 -->
            <Border x:Name="ToolbarSurface" Grid.Row="3" Background="#1C3551" BorderBrush="#3B5A77" BorderThickness="0,0,0,1" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BrowserActionButtonStyle}" Margin="0,0,7,0" Click="BackButton_Click" ToolTip="戻る" x:Name="BackButton" IsEnabled="False">
                        <Viewbox>
                            <Path x:Name="BackButtonIcon" Fill="#7387A6" Data="M15,4 L6,12 L15,20 L17,18 L10,12 L17,6 Z" />
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource BrowserActionButtonStyle}" Margin="0,0,9,0" Click="ForwardButton_Click" ToolTip="進む" x:Name="ForwardButton" IsEnabled="False">
                        <Viewbox>
                            <Path x:Name="ForwardButtonIcon" Fill="#7387A6" Data="M9,4 L18,12 L9,20 L7,18 L14,12 L7,6 Z" />
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource BrowserActionButtonStyle}" Margin="0,0,9,0" Click="HomeButton_Click" ToolTip="ホームを開く">
                        <Viewbox>
                            <Path Fill="{StaticResource AccentSecondaryBrush}" Data="M4,11 L12,4 L20,11 L18.5,12.8 L17,11.5 L17,20 L7,20 L7,11.5 L5.5,12.8 Z M10,18 L14,18 L14,13 L10,13 Z" />
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource BrowserActionButtonStyle}" Margin="0,0,9,0" Click="NewTabButton_Click" ToolTip="新しいタブ">
                        <Viewbox>
                            <Path Fill="{StaticResource AccentSecondaryBrush}" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z" />
                        </Viewbox>
                    </Button>
                    <TextBox Grid.Column="4" x:Name="UrlTextBox" VerticalContentAlignment="Center" KeyDown="UrlTextBox_KeyDown" />
                    <Button Grid.Column="5" Style="{StaticResource BrowserActionButtonStyle}" Margin="9,0,0,0" Click="OpenButton_Click" ToolTip="開く">
                        <Viewbox>
                            <Path Fill="{StaticResource AccentSecondaryBrush}" Data="M12,4 L20,4 L20,12 L17.5,12 L17.5,8.3 L9.8,16 L8,14.2 L15.7,6.5 L12,6.5 Z M5,6 L10,6 L10,8.5 L7.5,8.5 L7.5,16.5 L15.5,16.5 L15.5,14 L18,14 L18,19 L5,19 Z" />
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource BrowserActionButtonStyle}" Margin="8,0,0,0" Click="ReloadButton_Click" ToolTip="再読み込み">
                        <Viewbox>
                            <Path Fill="{StaticResource AccentSecondaryBrush}" Data="M12,4 A8,8 0 1 0 19.5,14 L17,14 A5.5,5.5 0 1 1 16.7,7.2 L14,10 L20,10 L20,4 L18.4,5.6 A8,8 0 0 0 12,4 Z" />
                        </Viewbox>
                    </Button>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="透明度" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <Slider x:Name="OpacitySlider" Width="115" Minimum="0.35" Maximum="1" Value="1" TickFrequency="0.05" ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityTextBlock" Width="42" Text="100%" Foreground="{StaticResource AccentSecondaryBrush}" VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- タブごとにCefSharpのブラウザを保持し、Webページにも透明度を反映する。 -->
            <Grid Grid.Row="4">
                <!-- タブ見出しの余白も透明な穴にせず、常にテーマ色で受け止める。 -->
                <Border x:Name="BrowserWorkspaceBackground" Background="{StaticResource WindowBackgroundBrush}" />
                <TabControl x:Name="BrowserTabControl" SelectionChanged="BrowserTabControl_SelectionChanged" />
                <!-- 右下へカーソルを合わせる位置を示すリサイズ用の目印。 -->
                <Path Width="22"
                      Height="22"
                      Margin="0,0,4,4"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Data="M4,18 L18,4 M9,18 L18,9 M14,18 L18,14"
                      Stroke="{StaticResource AccentSecondaryBrush}"
                      StrokeThickness="1.5"
                      Opacity="0.75"
                      IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
