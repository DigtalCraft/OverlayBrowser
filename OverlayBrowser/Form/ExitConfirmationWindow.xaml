<Window x:Class="OverlayBrowser.Form.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Browser"
        Width="440"
        Height="230"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#EDF6FF"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="CenterOwner">
    <Border Background="#0D1426" BorderBrush="#65D8F4" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- メイン画面と同じ青黒とシアンで確認画面を統一する。 -->
            <Border Background="#0B1324" BorderBrush="#233557" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="#162641" BorderBrush="#65D8F4" BorderThickness="1" CornerRadius="5" Padding="2">
                            <Image Source="/Assets/OverlayBrowser.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="9,0,0,0" Text="Overlay Browser" FontWeight="SemiBold" Foreground="#EDF6FF" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Width="46" Height="42" HorizontalAlignment="Right" Content="×" FontSize="20" Foreground="#D9EAFA" Background="Transparent" BorderThickness="0" Click="NoButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="オーバーレイブラウザを終了しますか？" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="94" Margin="0,0,10,0" Content="いいえ / No" Background="#243650" BorderBrush="#55738F" Foreground="#F4FAFF" Click="NoButton_Click" />
                    <Button Width="94" Content="はい / Yes" Background="#346E96" BorderBrush="#77DDF4" Foreground="#F4FAFF" Click="YesButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
