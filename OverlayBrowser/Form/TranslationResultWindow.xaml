<Window x:Class="OverlayBrowser.Form.TranslationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Browser - 翻訳結果"
        Width="680"
        Height="500"
        MinWidth="480"
        MinHeight="320"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleTextBlock" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        <TextBox x:Name="TranslationTextBox" Grid.Row="1" Margin="0,16,0,0" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="100" Margin="0,0,10,0" Content="コピー" Click="CopyButton_Click" />
            <Button Width="100" Content="閉じる" Background="#243650" BorderBrush="#55738F" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
