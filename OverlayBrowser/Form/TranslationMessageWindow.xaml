<Window x:Class="OverlayBrowser.Form.TranslationMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻訳"
        Width="520"
        Height="250"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource MainTextBrush}"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 翻訳画面でもアプリ本体と同じタイトルバーを使う。 -->
            <Border Grid.Row="0"
                    Background="#0B1324"
                    BorderBrush="#233557"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                Background="#162641"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3">
                            <Image Source="/Assets/OverlayBrowser.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="TitleTextBlock"
                                   Margin="10,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MainTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Width="44"
                            Height="44"
                            HorizontalAlignment="Right"
                            Content="×"
                            FontSize="20"
                            Foreground="{StaticResource SubTextBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="1"
                       Margin="26,24,26,12"
                       Foreground="{StaticResource MainTextBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <Button Grid.Row="2"
                    Width="86"
                    Margin="20,0,20,20"
                    HorizontalAlignment="Right"
                    Content="閉じる"
                    Background="#346E96"
                    BorderBrush="#77DDF4"
                    Foreground="#F4FAFF"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>
