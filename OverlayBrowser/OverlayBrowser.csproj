<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイの通知アイコンをWindows Formsの標準部品で表示する。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- CefSharp のネイティブ実行ファイルを確実に配置するため、64bit Windows を対象にする。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\OverlayBrowser.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF の描画ツリーへ組み込める Chromium ブラウザを使用する。 -->
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="150.0.110" />
  </ItemGroup>

  <ItemGroup>
    <!-- 実行ファイルのアイコンと画面左上のロゴとして使用する。 -->
    <Resource Include="Assets\OverlayBrowser.png" />
  </ItemGroup>

</Project>
